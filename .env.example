# Copy to .env and fill in real values. Never commit .env itself
# (it's already in .gitignore).
#
# EC2 #1 (Airflow/Streamlit) and EC2 #2 (agent) each need their own .env
# with the relevant subset of these — see comments below for which.

# --- AWS (EC2 #1: DAG reads/writes S3; EC2 #2: agent's ~/.aws mount) ---
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_DEFAULT_REGION=us-east-1

# --- RDS Postgres ---
# PIPELINE_DB_CONN: single URL, used by the DAG's Python code and the agent.
# PIPELINE_DB_HOST/PORT/USER/PASSWORD/NAME: discrete fields, used only by
# dbt_project/profiles.yml (EC2 #1 only — dbt doesn't accept a URL).
# AIRFLOW_DB_CONN: Airflow's own metadata DB (EC2 #1 only).
PIPELINE_DB_CONN=postgresql+psycopg2://postgres:your-password@your-rds-endpoint:5432/fda_pipeline
PIPELINE_DB_HOST=your-rds-endpoint
PIPELINE_DB_PORT=5432
PIPELINE_DB_USER=postgres
PIPELINE_DB_PASSWORD=your-rds-password
PIPELINE_DB_NAME=fda_pipeline
AIRFLOW_DB_CONN=postgresql+psycopg2://airflow:airflow@your-rds-endpoint:5432/airflow

# --- Self-healing agent (EC2 #2 only) ---
OPENAI_API_KEY=your-openai-key-here

# Slack app credentials — bot token needs chat:write; signing secret is
# used to verify /slack/actions button-click requests actually came from
# Slack (see agent/mcp_servers/slack_server.py).
SLACK_BOT_TOKEN=xoxb-your-token-here
SLACK_CHANNEL=#data-pipeline
SLACK_SIGNING_SECRET=your-signing-secret-here

# Qdrant Cloud (not a local container)
QDRANT_URL=https://your-cluster.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key

# --- EC2 #1 only: where the agent (EC2 #2) actually lives, since it's no
# longer reachable via Docker DNS as a sibling container. Prefer the
# agent instance's private IP (stable across stop/start), not public. ---
AGENT_ALERT_URL=http://172.31.41.43:8000/alert

# --- Airflow REST API — EC2 #2 (agent: retry tasks, pause the DAG on P0)
# and EC2 #1 (dashboard: check whether the DAG is currently paused).
# Same admin/admin as the Airflow UI login; change this if you ever
# change that. ---
AIRFLOW_API_URL=http://18.226.58.5:8080/api/v1
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin

# --- Escalation (EC2 #2 only) ---
# SLACK_TIMEOUT_MINUTES: how long a P1/P0 Slack message can go
# unanswered before escalation_scheduler.py takes the next step (P1
# auto-applies; P0 emails at 1x this value, re-confirms the pause at 2x).
SLACK_TIMEOUT_MINUTES=30
ESCALATION_EMAIL=geethaponugoti38@gmail.com

# SMTP_PASSWORD must be a Gmail App Password (myaccount.google.com/apppasswords),
# not your real account password — Gmail rejects the latter for SMTP
# once 2FA is on, which it should be regardless.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=geethaponugoti38@gmail.com
SMTP_PASSWORD=your-gmail-app-password
