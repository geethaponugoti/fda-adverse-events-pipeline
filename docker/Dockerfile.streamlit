FROM python:3.11-slim

WORKDIR /app

RUN pip install --no-cache-dir \
    streamlit \
    pandas \
    sqlalchemy \
    psycopg2-binary

COPY scripts/ ./scripts/
COPY .streamlit/ ./.streamlit/

EXPOSE 8501

CMD ["streamlit", "run", "scripts/dashboard.py", \
     "--server.port=8501", "--server.address=0.0.0.0"]